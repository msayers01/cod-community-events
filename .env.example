# Postgres (docker compose default)
DATABASE_URL=postgresql://cod:cod@localhost:5432/cod?schema=public
# Redis (docker compose default)
REDIS_URL=redis://localhost:6379

# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (create apps at the respective developer portals)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Discord bot
DISCORD_BOT_TOKEN=

# Real-time server (Socket.IO)
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# Comma-separated browser origins allowed to connect; defaults to NEXT_PUBLIC_APP_URL
REALTIME_CORS_ORIGINS=
