// Phase 1 schema. Organized by module; each model belongs to exactly one module.
// See docs/03-data-model.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum AccountStatus {
  ACTIVE
  WARNED
  SUSPENDED
  BANNED
}

enum StaffRoleKind {
  TRIAL_MODERATOR
  MODERATOR
  ADMIN
  FOUNDER
}

model User {
  id            String        @id @default(cuid())
  // Better Auth core fields
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Platform fields
  displayName   String        @unique
  activisionId  String?
  streamUrl     String?
  bio           String        @default("")
  status        AccountStatus @default(ACTIVE)

  sessions          Session[]
  accounts          Account[]
  staffRole         StaffRole?
  conflicts         ConflictDeclaration[] @relation("StaffConflicts")
  conflictedBy      ConflictDeclaration[] @relation("ConflictedUser")
  hosterProfile     HosterProfile?
  registrations     Registration[]
  teamMemberships   RoundTeamMember[]
  spinsTriggered    Spin[]
  reportsFiled      Report[]              @relation("Reporter")
  reportsReceived   Report[]              @relation("Reported")
  reportsAssigned   Report[]              @relation("AssignedStaff")
  evidence          Evidence[]
  sanctions         Sanction[]            @relation("SanctionedUser")
  sanctionsIssued   Sanction[]            @relation("SanctionIssuer")
  staffNotes        StaffNote[]           @relation("NoteSubject")
  staffNotesWritten StaffNote[]           @relation("NoteAuthor")
  staffActions      StaffActionLog[]
  notifications     Notification[]
  invitesReceived   EventInvite[]
  payoutConfirmations PayoutConfirmation[]
  registrationsMarkedPaid Registration[] @relation("MarkedPaidBy")
  discordConfigs    DiscordServerConfig[]
  resultSubmissions ResultSubmission[]
  matchStats        PlayerMatchStat[]
  confirmations     Confirmation[]
  disputeResolutions DisputeResolution[]
  ratingsGiven      TeammateRating[]      @relation("Rater")
  ratingsReceived   TeammateRating[]      @relation("Rated")
  hosterReviews     HosterReview[]
  badges            UserBadge[]
  reputation        ReputationSummary?
  blacklistEntries  BlacklistEntry[]      @relation("BlacklistedUser")
  blacklistProposed BlacklistEntry[]      @relation("BlacklistProposer")
  blacklistApprovals BlacklistApproval[]
  appeals           Appeal[]              @relation("Appellant")
  appealsHandled    Appeal[]              @relation("AppealHandler")
  throwFlags        ThrowFlag[]           @relation("FlaggedUser")
  throwFlagsRelated ThrowFlag[]           @relation("FlagRelatedUser")
  throwFlagsReviewed ThrowFlag[]          @relation("FlagReviewer")
  leaderboardEntries LeaderboardEntry[]
  seasonsCreated    Season[]

  @@map("user")
}

// Better Auth session table
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Better Auth account table = "Linked Account" in the data model (Discord, Twitch, X).
model Account {
  id                    String    @id @default(cuid())
  accountId             String // platform account id
  providerId            String // discord | twitch | twitter
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // Platform handle at link time, for duplicate/alt detection and display.
  handle                String?

  @@unique([providerId, accountId])
  @@unique([providerId, userId])
  @@index([userId])
  @@map("account")
}

// Better Auth verification table
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model StaffRole {
  userId      String        @id
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        StaffRoleKind
  badgeHidden Boolean       @default(false)
  grantedById String?
  grantedAt   DateTime      @default(now())

  @@map("staff_role")
}

model ConflictDeclaration {
  id               String   @id @default(cuid())
  staffUserId      String
  staffUser        User     @relation("StaffConflicts", fields: [staffUserId], references: [id], onDelete: Cascade)
  conflictedUserId String
  conflictedUser   User     @relation("ConflictedUser", fields: [conflictedUserId], references: [id], onDelete: Cascade)
  note             String   @default("")
  createdAt        DateTime @default(now())

  @@unique([staffUserId, conflictedUserId])
  @@map("conflict_declaration")
}

// ───────────────────────────── Events ─────────────────────────────

enum HosterTier {
  NEW
  VERIFIED
  TRUSTED
}

enum GameMode {
  SND
  HARDPOINT
}

enum EventFormat {
  SWITCHEROO
  STANDARD
}

enum EntryType {
  OPEN
  REQUIREMENT_BASED
  INVITE_ONLY
}

/// Which Call of Duty title an event is played in. Null on events created before this existed.
enum Game {
  MW3
  BO6
  BO7
  MW4
}

enum RandomizationMode {
  RANDOM
  SKILL_BALANCED
  NO_REPEAT_TEAMMATES
}

enum Platform {
  PC
  PLAYSTATION
  XBOX
  CROSSPLAY
}

enum Region {
  NA_EAST
  NA_WEST
  EU
  OCE
  OTHER
}

enum EventStatus {
  DRAFT
  OPEN
  CHECK_IN
  LIVE
  PAUSED
  COMPLETED
  ARCHIVED
  CANCELLED
}

model HosterProfile {
  userId         String     @id
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           HosterTier @default(NEW)
  tierSetManually Boolean   @default(false)
  foundingHoster Boolean    @default(false)
  twitterHandle  String?
  discordInvite  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  events    Event[]
  templates EventTemplate[]

  @@map("hoster_profile")
}

model EventTemplate {
  id          String        @id @default(cuid())
  hosterId    String
  hoster      HosterProfile @relation(fields: [hosterId], references: [userId], onDelete: Cascade)
  name        String
  settings    Json // validated by createEventSchema minus times
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([hosterId, name])
  @@map("event_template")
}

model Event {
  id                String        @id @default(cuid())
  hosterId          String
  hoster            HosterProfile @relation(fields: [hosterId], references: [userId])
  title             String
  slug              String        @unique
  description       String        @default("")
  mode              GameMode
  game              Game?
  format            EventFormat
  teamSize          Int
  roundCount        Int?
  playerCap         Int
  entryFeeCents     Int           @default(0)
  currency          String        @default("USD")
  payoutSplit       Json
  region            Region
  platform          Platform
  rules             Json
  entryType         EntryType     @default(OPEN)
  entryRequirements Json?
  /// How the wheel forms teams. RANDOM is the default; the others are hoster opt-ins.
  randomization     RandomizationMode @default(RANDOM)
  startsAt          DateTime
  checkInOpensAt    DateTime
  checkInClosesAt   DateTime
  status            EventStatus   @default(DRAFT)
  joinCode          String        @unique
  overlayKey        String        @unique
  publishedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  /// Set once the hoster records winners after completion.
  winnersRecordedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registrations       Registration[]
  invites             EventInvite[]
  rounds              Round[]
  spins               Spin[]
  reports             Report[]
  payoutConfirmations PayoutConfirmation[]
  reviews             HosterReview[]

  @@index([status, startsAt])
  @@index([hosterId])
  @@map("event")
}

// ───────────────────────────── Registration ─────────────────────────────

enum RegistrationStatus {
  WAITLISTED
  CONFIRMED
  CHECKED_IN
  IN_POOL
  NO_SHOW
  WITHDRAWN
  REMOVED
}

enum SignupSource {
  WEBSITE
  JOIN_LINK
  QUICK_ADD
}

model Registration {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerId         String
  player           User               @relation(fields: [playerId], references: [id])
  status           RegistrationStatus @default(WAITLISTED)
  source           SignupSource       @default(WEBSITE)
  waitlistPosition Int?
  markedPaidById   String?
  markedPaidBy     User?              @relation("MarkedPaidBy", fields: [markedPaidById], references: [id])
  markedPaidAt     DateTime?
  checkedInAt      DateTime?
  removedReason    String?
  blacklistFlagged Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([eventId, playerId])
  @@index([eventId, status])
  @@index([playerId])
  @@map("registration")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model EventInvite {
  id            String       @id @default(cuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedUser   User         @relation(fields: [invitedUserId], references: [id], onDelete: Cascade)
  status        InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  respondedAt   DateTime?

  @@unique([eventId, invitedUserId])
  @@map("event_invite")
}

// ───────────────────────────── Wheel ─────────────────────────────

enum SpinStatus {
  COMMITTED
  SPUN
  REVEALED
}

model Spin {
  id            String     @id @default(cuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roundId       String     @unique
  round         Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  /// Canonical pool snapshot: { playerIds: string[], teamSize: number }
  pool          Json
  poolHash      String
  commitment    String
  /// Encrypted-at-rest is a later concern; null until revealed in public reads.
  secret        String
  revealedSecret String?
  result        Json?
  status        SpinStatus @default(COMMITTED)
  triggeredById String
  triggeredBy   User       @relation(fields: [triggeredById], references: [id])
  committedAt   DateTime   @default(now())
  spunAt        DateTime?
  revealedAt    DateTime?

  @@index([eventId])
  @@map("spin")
}

// ───────────────────────────── Matches (Phase 1 subset) ─────────────────────────────

enum RoundStatus {
  PENDING
  SPUN
  IN_PROGRESS
  COMPLETE
}

model Round {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roundNumber Int
  status      RoundStatus @default(PENDING)
  createdAt   DateTime    @default(now())

  spin    Spin?
  teams   RoundTeam[]
  matches Match[]

  @@unique([eventId, roundNumber])
  @@map("round")
}

model RoundTeam {
  id      String            @id @default(cuid())
  roundId String
  round   Round             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  label   String
  members RoundTeamMember[]
  matchesAsA Match[] @relation("TeamA")
  matchesAsB Match[] @relation("TeamB")
  matchesWon Match[] @relation("WinningTeam")

  @@unique([roundId, label])
  @@map("round_team")
}

model RoundTeamMember {
  teamId String
  team   RoundTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("round_team_member")
}

// ───────────────────────────── Reputation (Phase 1 subset) ─────────────────────────────

enum PayoutResponse {
  PAID
  NOT_PAID
  NO_RESPONSE
}

model PayoutConfirmation {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  winnerId    String
  winner      User            @relation(fields: [winnerId], references: [id])
  place       Int
  response    PayoutResponse  @default(NO_RESPONSE)
  deadline    DateTime
  reminderSentAt DateTime?
  respondedAt DateTime?
  note        String?
  createdAt   DateTime        @default(now())

  @@unique([eventId, winnerId])
  @@map("payout_confirmation")
}

// ───────────────────────────── Moderation ─────────────────────────────

enum ReportCategory {
  NON_PAYMENT
  CHEATING
  THROWING
  REPEATED_NO_SHOWS
  HARASSMENT
  FALSIFIED_RESULTS
}

enum ReportStatus {
  SUBMITTED
  GATHERING_EVIDENCE
  AWAITING_RESPONSE
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

model Report {
  id              String         @id @default(cuid())
  reporterId      String
  reporter        User           @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String
  reportedUser    User           @relation("Reported", fields: [reportedUserId], references: [id])
  eventId         String?
  event           Event?         @relation(fields: [eventId], references: [id])
  matchId         String?
  category        ReportCategory
  description     String
  status          ReportStatus   @default(SUBMITTED)
  assignedStaffId String?
  assignedStaff   User?          @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  accusedResponse String?
  responseDeadline DateTime?
  respondedAt     DateTime?
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  evidence        Evidence[]
  sanctions       Sanction[]
  blacklistEntries BlacklistEntry[]

  @@index([reportedUserId])
  @@index([status])
  @@map("report")
}

enum EvidenceType {
  SCREENSHOT
  VOD
  PAYMENT_RECORD
  OTHER
}

model Evidence {
  id            String       @id @default(cuid())
  reportId      String
  report        Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type          EvidenceType
  /// External link (VOD, screenshot host) when no file was uploaded.
  url           String?
  /// Object key in private storage when a file was uploaded.
  storageKey    String?
  note          String       @default("")
  submittedById String
  submittedBy   User         @relation(fields: [submittedById], references: [id])
  createdAt     DateTime     @default(now())

  @@map("evidence")
}

enum SanctionType {
  WARNING
  SUSPENSION
  PERMANENT_BAN
}

model Sanction {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation("SanctionedUser", fields: [userId], references: [id])
  type       SanctionType
  reason     String
  startsAt   DateTime     @default(now())
  endsAt     DateTime?
  reportId   String?
  report     Report?      @relation(fields: [reportId], references: [id])
  issuedById String
  issuedBy   User         @relation("SanctionIssuer", fields: [issuedById], references: [id])
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@map("sanction")
}

model StaffNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("staff_note")
}

/// Append-only. A database trigger (see migration 0001) rejects UPDATE and DELETE.
model StaffActionLog {
  id          String   @id @default(cuid())
  staffUserId String
  staffUser   User     @relation(fields: [staffUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([staffUserId])
  @@map("staff_action_log")
}


// ───────────────────────────── Matches (Phase 2) ─────────────────────────────

enum MatchStatus {
  SCHEDULED
  RESULT_PENDING
  VERIFIED
  DISPUTED
  UNDER_REVIEW
  REJECTED
}

enum SubmissionStatus {
  PENDING
  VERIFIED
  DISPUTED
  UNCONFIRMED
  UNDER_REVIEW
  REJECTED
}

enum ConfirmationResponse {
  CONFIRM
  DISPUTE
}

model Match {
  id            String      @id @default(cuid())
  roundId       String
  round         Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamAId       String
  teamA         RoundTeam   @relation("TeamA", fields: [teamAId], references: [id])
  teamBId       String
  teamB         RoundTeam   @relation("TeamB", fields: [teamBId], references: [id])
  maps          Json        @default("[]")
  status        MatchStatus @default(SCHEDULED)
  winningTeamId String?
  winningTeam   RoundTeam?  @relation("WinningTeam", fields: [winningTeamId], references: [id])
  createdAt     DateTime    @default(now())

  submissions ResultSubmission[]
  stats       PlayerMatchStat[]
  ratings     TeammateRating[]

  @@index([roundId])
  @@map("match")
}

enum StatSource {
  MANUAL
  OCR
}

model ResultSubmission {
  id                   String           @id @default(cuid())
  matchId              String
  match                Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedById        String
  submittedBy          User             @relation(fields: [submittedById], references: [id])
  /// Required scoreboard screenshot: a link or a private upload.
  screenshotUrl        String?
  screenshotKey        String?
  scoreA               Int
  scoreB               Int
  winningTeamId        String
  status               SubmissionStatus @default(PENDING)
  verificationDeadline DateTime
  resolvedAt           DateTime?
  createdAt            DateTime         @default(now())

  stats         PlayerMatchStat[]
  confirmations Confirmation[]
  resolution    DisputeResolution?
  reading       ScreenshotReading?

  @@index([matchId])
  @@index([status, verificationDeadline])
  @@map("result_submission")
}

model PlayerMatchStat {
  id              String           @id @default(cuid())
  matchId         String
  match           Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submissionId    String
  submission      ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  playerId        String
  player          User             @relation(fields: [playerId], references: [id])
  kills           Int
  deaths          Int
  plants          Int?
  defuses         Int?
  hillTimeSeconds Int?
  verified        Boolean          @default(false)
  /// MANUAL = typed in by the submitter; OCR = read from the screenshot by the worker.
  source          StatSource       @default(MANUAL)

  @@unique([submissionId, playerId])
  @@index([playerId, verified])
  @@map("player_match_stat")
}

model Confirmation {
  id              String               @id @default(cuid())
  submissionId    String
  submission      ResultSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  playerId        String
  player          User                 @relation(fields: [playerId], references: [id])
  response        ConfirmationResponse
  disputeReason   String?
  correctedValues Json?
  respondedAt     DateTime             @default(now())

  @@unique([submissionId, playerId])
  @@map("confirmation")
}

model DisputeResolution {
  id           String           @id @default(cuid())
  submissionId String           @unique
  submission   ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  resolvedById String
  resolvedBy   User             @relation(fields: [resolvedById], references: [id])
  outcome      SubmissionStatus // VERIFIED or REJECTED
  reason       String
  createdAt    DateTime         @default(now())

  @@map("dispute_resolution")
}

// ───────────────────────────── Reputation (Phase 2) ─────────────────────────────

model TeammateRating {
  id             String   @id @default(cuid())
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId        String
  rater          User     @relation("Rater", fields: [raterId], references: [id])
  ratedId        String
  rated          User     @relation("Rated", fields: [ratedId], references: [id])
  wouldPlayAgain Boolean
  communication  Int // 1-5
  effort         Int // 1-5
  createdAt      DateTime @default(now())

  @@unique([matchId, raterId, ratedId])
  @@index([ratedId])
  @@map("teammate_rating")
}

model HosterReview {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User     @relation(fields: [reviewerId], references: [id])
  organization  Int // 1-5
  communication Int // 1-5
  fairness      Int // 1-5
  comment       String?
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([eventId, reviewerId])
  @@map("hoster_review")
}

enum BadgeKind {
  FOUNDER
  ADMIN
  MODERATOR
  NEW_HOSTER
  VERIFIED_HOSTER
  TRUSTED_HOSTER
  FOUNDING_HOSTER
  VERIFIED_PLAYER
  SUPPORTER
}

enum BadgeSource {
  AUTOMATIC
  GRANTED
}

model UserBadge {
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       BadgeKind
  source      BadgeSource @default(AUTOMATIC)
  grantedById String?
  createdAt   DateTime    @default(now())

  @@id([userId, badge])
  @@map("user_badge")
}

/// Pre-calculated per-user totals for fast profile loads. Recalculated by the worker.
model ReputationSummary {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventsPlayed            Int      @default(0)
  eventsHosted            Int      @default(0)
  confirmedPayouts        Int      @default(0)
  deniedPayouts           Int      @default(0)
  noShows                 Int      @default(0)
  verifiedMatches         Int      @default(0)
  verifiedWins            Int      @default(0)
  kills                   Int      @default(0)
  deaths                  Int      @default(0)
  plants                  Int      @default(0)
  defuses                 Int      @default(0)
  hillTimeSeconds         Int      @default(0)
  ratingCount             Int      @default(0)
  wouldPlayAgainPct       Float?
  communicationAvg        Float?
  effortAvg               Float?
  confirmationsAsked      Int      @default(0)
  confirmationsAnswered   Int      @default(0)
  reviewCount             Int      @default(0)
  organizationAvg         Float?
  hosterCommunicationAvg  Float?
  fairnessAvg             Float?
  updatedAt               DateTime @updatedAt

  @@map("reputation_summary")
}

// ───────────────────────────── Blacklist & appeals (Phase 2) ─────────────────────────────

enum BlacklistStatus {
  PROPOSED
  AWAITING_SECOND_APPROVAL
  ACTIVE
  EXPIRED
  REMOVED
}

model BlacklistEntry {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("BlacklistedUser", fields: [userId], references: [id])
  category      ReportCategory
  /// Carefully worded public text, e.g. "Verified report: unpaid winnings from X, evidence reviewed".
  publicWording String
  reportId      String?
  report        Report?         @relation(fields: [reportId], references: [id])
  status        BlacklistStatus @default(PROPOSED)
  proposedById  String
  proposedBy    User            @relation("BlacklistProposer", fields: [proposedById], references: [id])
  expiresAt     DateTime?
  activatedAt   DateTime?
  removedAt     DateTime?
  removedReason String?
  createdAt     DateTime        @default(now())

  approvals BlacklistApproval[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("blacklist_entry")
}

model BlacklistApproval {
  id          String         @id @default(cuid())
  entryId     String
  entry       BlacklistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  staffUserId String
  staffUser   User           @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime       @default(now())

  @@unique([entryId, staffUserId])
  @@map("blacklist_approval")
}

enum AppealTarget {
  BLACKLIST_ENTRY
  SANCTION
  DISPUTE_RULING
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  OVERTURNED
}

model Appeal {
  id             String       @id @default(cuid())
  appellantId    String
  appellant      User         @relation("Appellant", fields: [appellantId], references: [id])
  target         AppealTarget
  targetId       String
  statement      String
  evidence       Json         @default("[]")
  status         AppealStatus @default(SUBMITTED)
  handledById    String?
  handledBy      User?        @relation("AppealHandler", fields: [handledById], references: [id])
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([appellantId, target, targetId])
  @@index([status])
  @@map("appeal")
}

// ───────────────────────────── Notifications & System ─────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String    @default("")
  href       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notification")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@map("outbox_event")
}

model DiscordServerConfig {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  filters        Json     @default("{}")
  configuredById String
  configuredBy   User     @relation(fields: [configuredById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([guildId, channelId])
  @@map("discord_server_config")
}


// ───────────────────────────── Phase 3: screenshot text recognition ─────────────────────────────

enum ReadingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

/// What the worker read from a submission's scoreboard screenshot. Advisory only:
/// it never verifies anything, it fills blanks and highlights disagreements.
model ScreenshotReading {
  id            String           @id @default(cuid())
  submissionId  String           @unique
  submission    ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status        ReadingStatus    @default(PENDING)
  provider      String           @default("tesseract")
  rawText       String?
  /// Mean word confidence 0-100 as reported by the engine.
  confidence    Float?
  /// Parsed scoreboard rows: [{ name, kills, deaths, ..., playerId | null }]
  rows          Json             @default("[]")
  /// Per-field differences between the reading and the submitted result.
  discrepancies Json             @default("[]")
  /// True when the reading filled in stats the submitter left blank.
  filledStats   Boolean          @default(false)
  error         String?
  attempts      Int              @default(0)
  startedAt     DateTime?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  @@index([status])
  @@map("screenshot_reading")
}

// ───────────────────────────── Phase 3: throw detection ─────────────────────────────

enum ThrowSignal {
  PERFORMANCE_DROP
  EVENT_LOSS_STREAK
  TEAMMATE_LOSS_PATTERN
}

enum ThrowFlagStatus {
  OPEN
  UNDER_REVIEW
  DISMISSED
  ESCALATED
}

/// An anomaly raised for moderator review. Never an accusation and never triggers
/// a sanction by itself. Detection thresholds live in code and are not stored here.
/// Staff-only: no public read path may include this table.
model ThrowFlag {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("FlaggedUser", fields: [userId], references: [id])
  signal        ThrowSignal
  /// Dedup key within (user, signal): match id, event id, or partner user id.
  scopeKey      String
  eventId       String?
  matchId       String?
  relatedUserId String?
  relatedUser   User?           @relation("FlagRelatedUser", fields: [relatedUserId], references: [id])
  /// Anomaly strength; larger is stranger. Used only to order the staff queue.
  score         Float
  details       Json
  status        ThrowFlagStatus @default(OPEN)
  reviewedById  String?
  reviewedBy    User?           @relation("FlagReviewer", fields: [reviewedById], references: [id])
  reviewNote    String?
  reportId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  resolvedAt    DateTime?

  @@unique([userId, signal, scopeKey])
  @@index([status, score])
  @@index([userId])
  @@map("throw_flag")
}

// ───────────────────────────── Phase 3: leaderboards ─────────────────────────────

enum LeaderboardPeriod {
  MONTH
  SEASON
  ALL_TIME
}

model Season {
  id          String   @id @default(cuid())
  name        String   @unique
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([startsAt, endsAt])
  @@map("season")
}

/// Pre-calculated standings. Rewritten wholesale per (period, periodKey, mode) by the worker.
model LeaderboardEntry {
  id        String            @id @default(cuid())
  period    LeaderboardPeriod
  /// "2026-10" for MONTH, the season id for SEASON, "all" for ALL_TIME.
  periodKey String
  mode      GameMode
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank      Int
  points    Int
  matches   Int
  wins      Int
  losses    Int
  kills     Int               @default(0)
  deaths    Int               @default(0)
  updatedAt DateTime          @updatedAt

  @@unique([period, periodKey, mode, userId])
  @@index([period, periodKey, mode, rank])
  @@index([userId])
  @@map("leaderboard_entry")
}
