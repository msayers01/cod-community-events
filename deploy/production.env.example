# Production configuration reference. Copy to .env.production for docker-compose.prod.yml, or set
# the same names as variables on each service in your host (see docs/05-deployment.md).
# The app checks these at start-up and refuses to run if the important ones are wrong.

# ── Required ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                      # compose only; hosts supply DATABASE_URL instead
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public   (hosted setups)
# REDIS_URL=redis://default:pass@host:6379                          (hosted setups)

# 48+ random characters:  openssl rand -base64 48
# Changing it later signs every user out.
BETTER_AUTH_SECRET=

# The public https address of the web app. Compiled into the browser bundle at BUILD time:
# change it => rebuild the image.
NEXT_PUBLIC_APP_URL=https://events.example.com
BETTER_AUTH_URL=https://events.example.com

# At least one sign-in provider (callback: <app url>/api/auth/callback/discord or /twitch)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Strongly recommended ────────────────────────────────────────────────────
# Public address of the realtime service (also BUILD time). Without it pages poll instead of
# updating live and the OBS overlay is slower.
NEXT_PUBLIC_REALTIME_URL=https://realtime.example.com
# Browser origins allowed to connect to realtime; defaults to NEXT_PUBLIC_APP_URL.
REALTIME_CORS_ORIGINS=https://events.example.com

# Private file storage (Cloudflare R2): all four, or none (uploads disabled, links still work).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Error reporting
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Optional ────────────────────────────────────────────────────────────────
# Only for the `bot` service (docker compose --profile bot).
DISCORD_BOT_TOKEN=
# Hosts the worker may fetch pasted screenshot links from (uploads are always readable).
SCREENSHOT_URL_HOSTS=i.imgur.com,cdn.discordapp.com,media.discordapp.net
